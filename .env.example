# Copy to .env and fill in real values. Do NOT commit .env.

# === Backend ===
# Anthropic API key for pain point extraction (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# AssemblyAI API key for transcription (https://www.assemblyai.com/app/account)
ASSEMBLYAI_API_KEY=...

# Postgres connection string. Default points at the docker-compose db service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_insights

# CORS origin for the frontend (comma-separated if multiple)
CORS_ORIGINS=http://localhost:3000

# === Frontend ===
# Backend base URL the Next.js app calls
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Audio storage location. Defaults to backend/storage/audio (relative to the
# backend root). On Render or other ephemeral hosts, point this at a mounted
# persistent disk, e.g. AUDIO_STORAGE_DIR=/var/data/audio
AUDIO_STORAGE_DIR=storage/audio
